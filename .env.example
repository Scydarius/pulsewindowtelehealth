# The public LiveKit WebSocket URL, for example wss://pulsewindow-xxxx.livekit.cloud
VITE_LIVEKIT_URL=

# A server endpoint that returns { "token": "..." } for an authenticated user.
# Never place the LiveKit API secret in this frontend repository.
VITE_LIVEKIT_TOKEN_ENDPOINT=

# The independently deployed PulseWindow rPPG API.
VITE_RPPG_API_URL=http://localhost:8000/api/v1

# Keep enabled until the real API is available.
VITE_USE_MOCK_RPPG=true
