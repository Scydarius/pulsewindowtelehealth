# The public LiveKit WebSocket URL, for example wss://pulsewindow-xxxx.livekit.cloud
VITE_LIVEKIT_URL=

# A server endpoint that returns { "token": "..." } for an authenticated user.
# Never place the LiveKit API secret in this frontend repository.
VITE_LIVEKIT_TOKEN_ENDPOINT=

# Server-only Vercel variables. Never prefix these with VITE_ or commit real values.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# local: real peer-to-peer video between two tabs on this browser/origin.
# livekit: production-ready remote calling through LiveKit Cloud.
VITE_VIDEO_PROVIDER=local

# The independently deployed PulseWindow rPPG API.
VITE_RPPG_API_URL=http://localhost:8000/api/v1

# Keep enabled until the real API is available.
VITE_USE_MOCK_RPPG=true

# Supabase client values (publishable only; these are safe in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Vercel value for invitation endpoints. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only rPPG settings. Set the API URL to the Railway service.
RPPG_API_URL=https://web-production-91be7.up.railway.app
RPPG_TICKET_SECRET=
