{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pulsewindowtelehealth.vercel.app"
        }
      ],
      "destination": "https://www.ventricura.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/google-calendar-callback", "destination": "/api/google-calendar?action=callback" },
    { "source": "/api/claim-initial-admin", "destination": "/api/admin-clinicians?action=claim-initial-admin" },
    { "source": "/api/patient-invitations", "destination": "/api/clinician-invitations?action=patient-invite" },
    { "source": "/patient", "destination": "/index.html" },
    { "source": "/clinician", "destination": "/index.html" },
    { "source": "/clinician/sign-in", "destination": "/index.html" },
    { "source": "/clinician/forgot-password", "destination": "/index.html" },
    { "source": "/clinician/reset-password", "destination": "/index.html" },
    { "source": "/clinician/activate", "destination": "/index.html" },
    { "source": "/clinician/patient", "destination": "/index.html" },
    { "source": "/clinician/review", "destination": "/index.html" },
    { "source": "/technology", "destination": "/index.html" },
    { "source": "/clinicians", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/security", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/clinicians", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/book/:path*", "destination": "/index.html" },
    { "source": "/consultation/:path*", "destination": "/index.html" }
  ]
}
